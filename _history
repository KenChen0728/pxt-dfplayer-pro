ck=\"初始化 TX %tx RX %rx\"\n    //% tx.defl=SerialPin.P14 rx.defl=SerialPin.P13\n    //% group=\"基本\"\n    export function init(tx: SerialPin, rx: SerialPin): void {\n        serial.redirect(tx, rx, BaudRate.BaudRate115200)\n        basic.pause(3000)\n        serial.writeLine(\"AT+AMP=ON\")\n        basic.pause(300)\n    }\n\n    //% block=\"測試連線\"\n    //% group=\"基本\"\n    export function testConnection(): string {\n        return sendAndRead(\"AT\")\n    }\n\n    //% block=\"喇叭功放 %on\"\n    //% on.shadow=\"toggleOnOff\"\n    //% group=\"基本\"\n    export function amp(on: boolean): void {\n        serial.writeLine(on ? \"AT+AMP=ON\" : \"AT+AMP=OFF\")\n    }\n\n    //% block=\"播放第 %n 號檔案\"\n    //% n.min=1 n.defl=1\n    //% group=\"播放\"\n    export function playNum(n: number): void {\n        serial.writeLine(\"AT+PLAYNUM=\" + n)\n    }\n\n    //% block=\"播放檔案 %path\"\n    //% path.defl=\"/test.mp3\"\n    //% group=\"播放\"\n    export function playFile(path: string): void {\n        serial.writeLine(\"AT+PLAYFILE=\" + path)\n    }\n\n    //% block=\"暫停／繼續播放\"\n    //% group=\"播放\"\n    export function pausePlay(): void {\n        serial.writeLine(\"AT+PLAY=PP\")\n    }\n\n    //% block=\"下一首\"\n    //% group=\"播放\"\n    export function next(): void {\n        serial.writeLine(\"AT+PLAY=NEXT\")\n    }\n\n    //% block=\"上一首\"\n    //% group=\"播放\"\n    export function last(): void {\n        serial.writeLine(\"AT+PLAY=LAST\")\n    }\n\n    //% block=\"設定播放模式 %mode\"\n    //% group=\"播放\"\n    export function setPlayMode(mode: DFPlayMode): void {\n        serial.writeLine(\"AT+PLAYMODE=\" + mode)\n    }\n\n    //% block=\"查詢播放模式\"\n    //% group=\"播放\"\n    export function queryPlayMode(): string {\n        return sendAndRead(\"AT+PLAYMODE=?\")\n    }\n\n    //% block=\"快進／快退 %sec 秒（負數為快退）\"\n    //% sec.defl=5\n    //% group=\"時間\"\n    export function seekBy(sec: number): void {\n        if (sec >= 0) {\n            serial.writeLine(\"AT+TIME=+\" + sec)\n        } else {\n            serial.writeLine(\"AT+TIME=\" + sec)\n        }\n    }\n\n    //% block=\"跳到第 %sec 秒開始播放\"\n    //% sec.min=0 sec.defl=0\n    //% group=\"時間\"\n    export function seekTo(sec: number): void {\n        serial.writeLine(\"AT+TIME=\" + sec)\n    }\n\n    //% block=\"查詢 %q\"\n    //% group=\"查詢\"\n    export function query(q: DFQuery): string {\n        return sendAndRead(\"AT+QUERY=\" + q)\n    }\n\n    //% block=\"設定音量為 %vol（此模組目前無效）\"\n    //% vol.min=0 vol.max=30 vol.defl=10\n    //% group=\"音量\"\n    export function setVolume(vol: number): void {\n        vol = Math.constrain(vol, 0, 30)\n        serial.writeLine(\"AT+VOL=\" + vol)\n    }\n\n    //% block=\"音量變化 %delta（此模組目前無效）\"\n    //% delta.defl=1\n    //% group=\"音量\"\n    export function changeVolume(delta: number): void {\n        if (delta >= 0) {\n            serial.writeLine(\"AT+VOL=+\" + delta)\n        } else {\n            serial.writeLine(\"AT+VOL=\" + delta)\n        }\n    }\n\n    //% block=\"查詢音量\"\n    //% group=\"音量\"\n    export function queryVolume(): string {\n        return sendAndRead(\"AT+VOL=?\")\n    }\n\n    //% block=\"提示音 %on\"\n    //% on.shadow=\"toggleOnOff\"\n    //% group=\"設定\"\n    export function prompt(on: boolean): void {\n        serial.writeLine(on ? \"AT+PROMPT=ON\" : \"AT+PROMPT=OFF\")\n    }\n\n    //% block=\"LED 指示燈 %on\"\n    //% on.shadow=\"toggleOnOff\"\n    //% group=\"設定\"\n    export function led(on: boolean): void {\n        serial.writeLine(on ? \"AT+LED=ON\" : \"AT+LED=OFF\")\n    }\n\n    //% block=\"刪除目前播放的檔案（無法復原）\"\n    //% group=\"進階（小心使用）\"\n    export function deleteCurrentFile(): void {\n        serial.writeLine(\"AT+DEL\")\n    }\n\n    //% block=\"設定模組鮑率 %baud（需重新上電）\"\n    //% baud.defl=115200\n    //% group=\"進階（小心使用）\"\n    export function setBaudrate(baud: number): void {\n        serial.writeLine(\"AT+BAUDRATE=\" + baud)\n    }\n}","pxt.json":"{\n    \"name\": \"test\",\n    \"description\": \"\",\n    \"dependencies\": {\n    